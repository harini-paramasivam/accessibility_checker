{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__path=/api/$1"
    },
    {
      "source": "/",
      "destination": "/api/index?__path=/"
    },
    {
      "source": "/legacy",
      "destination": "/api/index?__path=/legacy"
    },
    {
      "source": "/legacy/(.*)",
      "destination": "/api/index?__path=/legacy/$1"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "static/**"
    }
  }
}
